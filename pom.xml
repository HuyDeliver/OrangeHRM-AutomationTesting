<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.orangehrm</groupId>
    <artifactId>orangehrm-automation-framework</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

   <properties>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <testng.suite>testng.xml</testng.suite>
    <module>Login,Admin,PIM,Recruitment,MyInfo,Performance,Profile,Time,Claim,PIMAPI,AdminAPI,RecruitmentAPI,Security</module>

    <selenium.version>4.48.0</selenium.version>
    <testng.version>7.12.0</testng.version>
    <log4j.version>2.24.3</log4j.version>
    <allure.version>2.29.0</allure.version>
    <poi.version>5.2.5</poi.version>
    <aspectj.version>1.9.22</aspectj.version>
    <restassured.version>6.0.1</restassured.version>
</properties>

    <dependencies>
        <!-- Selenium WebDriver -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
        </dependency>

        <!-- TestNG -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
        </dependency>

        <!-- Log4j2 - ghi log -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>${log4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>${log4j.version}</version>
        </dependency>

        <!-- Allure - báo cáo test -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-testng</artifactId>
            <version>${allure.version}</version>
        </dependency>

        <!-- Apache POI - đọc/ghi file Excel -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>

        <!-- Rest Assured - API Testing -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>${restassured.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Chạy test bằng Maven -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <suiteXmlFiles>
                        <suiteXmlFile>${testng.suite}</suiteXmlFile>
                    </suiteXmlFiles>
                    <properties>
                        <property>
                            <name>testnames</name>
                            <value>${module}</value>
                        </property>
                    </properties>
                    <failIfNoTests>true</failIfNoTests>
                    <!-- Cần cho Allure gắn ảnh/annotation vào report đúng cách -->
                    <argLine>
                        -javaagent:"${settings.localRepository}/org/aspectj/aspectjweaver/${aspectj.version}/aspectjweaver-${aspectj.version}.jar"
                    </argLine>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.aspectj</groupId>
                        <artifactId>aspectjweaver</artifactId>
                        <version>${aspectj.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>cd-api</id>
            <properties>
                <module>PIMAPI,AdminAPI,RecruitmentAPI</module>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <reportsDirectory>${project.build.directory}/cd-api/surefire</reportsDirectory>
                            <systemPropertyVariables>
                                <cd.api>true</cd.api>
                                <allure.results.directory>${project.build.directory}/cd-allure-results</allure.results.directory>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>cd-security</id>
            <properties>
                <module>Security</module>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <reportsDirectory>${project.build.directory}/cd-security/surefire</reportsDirectory>
                            <systemPropertyVariables>
                                <cd.api>true</cd.api>
                                <allure.results.directory>${project.build.directory}/cd-allure-results</allure.results.directory>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>cd-performance</id>
            <properties>
                <module>Performance</module>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <reportsDirectory>${project.build.directory}/cd-performance/surefire</reportsDirectory>
                            <systemPropertyVariables>
                                <cd.run>true</cd.run>
                                <cd.performance>true</cd.performance>
                                <allure.results.directory>${project.build.directory}/cd-allure-results</allure.results.directory>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>cd-time</id>
            <properties>
                <module>Time</module>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <reportsDirectory>${project.build.directory}/cd-time/surefire</reportsDirectory>
                            <systemPropertyVariables>
                                <cd.run>true</cd.run>
                                <cd.time>true</cd.time>
                                <allure.results.directory>${project.build.directory}/cd-allure-results</allure.results.directory>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>cd-claim</id>
            <properties>
                <module>Claim</module>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <reportsDirectory>${project.build.directory}/cd-claim/surefire</reportsDirectory>
                            <systemPropertyVariables>
                                <cd.run>true</cd.run>
                                <cd.claim>true</cd.claim>
                                <allure.results.directory>${project.build.directory}/cd-allure-results</allure.results.directory>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>cd-profile</id>
            <properties>
                <module>Profile</module>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <reportsDirectory>${project.build.directory}/cd-profile/surefire</reportsDirectory>
                            <systemPropertyVariables>
                                <cd.run>true</cd.run>
                                <cd.profile>true</cd.profile>
                                <allure.results.directory>${project.build.directory}/cd-allure-results</allure.results.directory>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>cd-myinfo</id>
            <properties>
                <module>MyInfo</module>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <reportsDirectory>${project.build.directory}/cd-myinfo/surefire</reportsDirectory>
                            <systemPropertyVariables>
                                <cd.run>true</cd.run>
                                <cd.myinfo>true</cd.myinfo>
                                <allure.results.directory>${project.build.directory}/cd-allure-results</allure.results.directory>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>cd-recruitment</id>
            <properties>
                <module>Recruitment</module>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <reportsDirectory>${project.build.directory}/cd-recruitment/surefire</reportsDirectory>
                            <systemPropertyVariables>
                                <cd.recruitment>true</cd.recruitment>
                                <allure.results.directory>${project.build.directory}/cd-allure-results</allure.results.directory>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>cd-pim-regression</id>
            <properties>
                <module>PIM</module>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <reportsDirectory>${project.build.directory}/cd-pim-regression/surefire</reportsDirectory>
                            <systemPropertyVariables>
                                <cd.pim>true</cd.pim>
                                <allure.results.directory>${project.build.directory}/cd-allure-results</allure.results.directory>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>cd-admin</id>
            <properties>
                <module>Admin</module>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <reportsDirectory>${project.build.directory}/cd-admin/surefire</reportsDirectory>
                            <systemPropertyVariables>
                                <cd.admin>true</cd.admin>
                                <allure.results.directory>${project.build.directory}/cd-allure-results</allure.results.directory>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>cd-admin-user</id>
            <properties>
                <module>CDAdminUser</module>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <reportsDirectory>${project.build.directory}/cd-admin-user/surefire</reportsDirectory>
                            <systemPropertyVariables>
                                <allure.results.directory>${project.build.directory}/cd-allure-results</allure.results.directory>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Ba case PIM độc lập, chỉ dùng fixture CD; report tách khỏi Login và seed. -->
        <profile>
            <id>cd-pim</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <test>com.hrm.TestCase.PIMTab.CDPIMTest</test>
                            <reportsDirectory>${project.build.directory}/cd-pim/surefire</reportsDirectory>
                            <properties combine.self="override">
                                <property>
                                    <name>listener</name>
                                    <value>com.hrm.Util.TestListener</value>
                                </property>
                            </properties>
                            <systemPropertyVariables>
                                <allure.results.directory>${project.build.directory}/cd-allure-results</allure.results.directory>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Setup riêng: report không trộn vào functional/security/regression. -->
        <profile>
            <id>cd-seed</id>
            <properties>
                <seed.output>${project.build.directory}/cd-seed/manual</seed.output>
                <seed.test>com.hrm.Setup.CDSeedTest</seed.test>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <test>${seed.test}</test>
                            <reportsDirectory>${seed.output}/surefire</reportsDirectory>
                            <properties combine.self="override" />
                            <systemPropertyVariables>
                                <seed.output>${seed.output}</seed.output>
                                <allure.results.directory>${seed.output}/allure-setup</allure.results.directory>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Chọn đúng OHR1, giữ listener khi không chạy qua testng.xml. -->
        <profile>
            <id>cd-smoke</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <test>LoginTest#loginSuccess</test>
                            <systemPropertyVariables>
                                <allure.results.directory>${project.build.directory}/cd-allure-results</allure.results.directory>
                            </systemPropertyVariables>
                            <properties combine.self="override">
                                <property>
                                    <name>listener</name>
                                    <value>com.hrm.Util.TestListener</value>
                                </property>
                            </properties>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
