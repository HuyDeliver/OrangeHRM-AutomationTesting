            <class name="com.hrm.TestCase.PIMTab.TerminateEmployeeFunctionality" />
            <class name="com.hrm.TestCase.PIMTab.Issue1876RegressionTest" />
        </classes>
    </test>

    <test name="Recruitment" preserve-order="true">
        <classes>
            <class name="com.hrm.TestCase.Recruitment.AddVacancyFunctionality" />
            <class name="com.hrm.TestCase.Recruitment.SearchVacancyFunctionality" />
            <class name="com.hrm.TestCase.Recruitment.DeleteVacancyFunctionality" />
            <class name="com.hrm.TestCase.Recruitment.AddCandidateFunctionality" />
            <class name="com.hrm.TestCase.Recruitment.RejectCandidateFunctionality" />
            <class name="com.hrm.TestCase.Recruitment.DeleteCandidateFunctionality" />
            <class name="com.hrm.TestCase.Recruitment.Issue1926RegressionTest" />
        </classes>
    </test>

