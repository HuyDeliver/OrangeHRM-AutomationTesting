<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="OrangeHRM Modules" verbose="1" parallel="none">
    <listeners>
        <listener class-name="com.hrm.Util.TestListener" />
    </listeners>

    <test name="Login" preserve-order="true">
        <classes>
            <class name="com.hrm.TestCase.LoginTab.LoginTest" />
        </classes>
    </test>

    <!-- Chạy cùng JVM để bốn class chia sẻ đúng TestDataShare.USERNAME. -->
