        <classes>
            <class name="com.hrm.Setup.CDAdminUserSetup" />
            <class name="com.hrm.TestCase.AdminTab.AddUserFunctionality" />
            <class name="com.hrm.TestCase.AdminTab.SearchUserWithValidData" />
            <class name="com.hrm.TestCase.AdminTab.EditUserFunctionality" />
            <class name="com.hrm.TestCase.AdminTab.DeleteUserFunctionality" />
        </classes>
    </test>

    <test name="Admin" preserve-order="true">
        <classes>
            <class name="com.hrm.TestCase.AdminTab.AddUserFunctionality" />
            <class name="com.hrm.TestCase.AdminTab.SearchUserWithInvalidData" />
            <class name="com.hrm.TestCase.AdminTab.SearchUserWithValidData" />
            <class name="com.hrm.TestCase.AdminTab.EditUserFunctionality" />
            <class name="com.hrm.TestCase.AdminTab.DeleteUserFunctionality" />
            <class name="com.hrm.TestCase.AdminTab.AddJobTitlesFunctionality" />
            <class name="com.hrm.TestCase.AdminTab.EditJobTitleFunctionality" />
            <class name="com.hrm.TestCase.AdminTab.DeleteJobTitlesFunctionality" />
            <class name="com.hrm.TestCase.AdminTab.AddLocationFunctionality" />
            <class name="com.hrm.TestCase.AdminTab.SearchLocationFunctionality" />
            <class name="com.hrm.TestCase.AdminTab.EditLocationFunctionality" />
            <class name="com.hrm.TestCase.AdminTab.DeleteLocationFunctionality" />
            <class name="com.hrm.TestCase.AdminTab.AddSkillFunctionality" />
            <class name="com.hrm.TestCase.AdminTab.EditSkillFunctionality" />
            <class name="com.hrm.TestCase.AdminTab.DeleteSkillFunctionality" />
            <class name="com.hrm.TestCase.AdminTab.Issue1897RegressionTest" />
        </classes>
    </test>

    <test name="PIM" preserve-order="true">
        <classes>
            <class name="com.hrm.TestCase.PIMTab.AddEmployeeFunctionality" />
            <class name="com.hrm.TestCase.PIMTab.SearchEmployeeFunctionality" />
            <class name="com.hrm.TestCase.PIMTab.EditJobDetailFunctionality" />
            <class name="com.hrm.TestCase.PIMTab.EditSalaryFunctionality" />
            <class name="com.hrm.TestCase.PIMTab.EditSupervisorFunctionality" />
